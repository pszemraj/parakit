#!/bin/sh
# parakit pre-commit hook.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass a single commit:  git commit --no-verify
#
# Checks run against the working tree, not the staged snapshot: commit from
# a clean tree, or accept that unstaged edits are checked too. Heavy checks
# only run when Rust-relevant files are staged; docs-only commits stay fast.
# The full validation loop (check --workspace, test, build) is still expected
# before pushing runtime changes.

set -e

say() { printf '%s\n' "pre-commit: $*"; }
fail() {
    say "$*"
    exit 1
}

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# Block accidental vendored-submodule pointer bumps: cargo fmt --all and
# stray tool runs have dirtied vendor/CrispASR before. Bump deliberately
# with --no-verify.
if printf '%s\n' "$staged" | grep -q '^vendor/'; then
    fail "staged change under vendor/ - bump the submodule deliberately with --no-verify"
fi

# Conflict markers and whitespace errors in the staged diff.
git diff --cached --check || fail "whitespace errors or conflict markers (see above)"

# Rust checks only when Rust-relevant files are staged.
if ! printf '%s\n' "$staged" | grep -Eq '\.rs$|^Cargo\.(toml|lock)$'; then
    exit 0
fi

command -v cargo >/dev/null 2>&1 || fail "cargo not found on PATH"

say "cargo fmt --package parakit -- --check"
cargo fmt --package parakit -- --check ||
    fail "formatting differs - run: cargo fmt --package parakit"

# Doc lint. Excludes vendored code, build output, agent worktrees under
# .claude/, and untracked local scratch.
if command -v rustdoc-checker >/dev/null 2>&1; then
    say "rustdoc-checker (missing/lazy docs)"
    rustdoc-checker . --exclude target,vendor,.claude,local-scratch --strict ||
        fail "rustdoc issues - document the items listed above"
else
    say "warning: rustdoc-checker not installed; skipping doc lint"
    say "  install: cargo install --git https://github.com/pszemraj/rustdoc-checker.git"
fi

# Clippy on the parakit package only: vendored CrispASR crates emit known
# deprecation warnings that must not gate parakit commits.
say "cargo clippy --package parakit --all-targets -- -D warnings"
cargo clippy --package parakit --all-targets -- -D warnings ||
    fail "clippy findings - fix or #[allow] with a reason"

say "ok"
